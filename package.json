{
  "name": "jordannesbitt-art",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers node --test tests/*.test.mjs",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers playwright install chromium firefox --only-shell",
    "build:preview": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build --mode preview --outDir /tmp/opencode/jordannesbitt-preview",
    "release:check": "node scripts/release-check.mjs",
    "check:output": "node scripts/check-output.mjs",
    "review": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers node scripts/review.mjs",
    "pilot": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers node scripts/pilot.mjs",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "ingest": "node scripts/ingest.mjs",
    "studio": "ASTRO_TELEMETRY_DISABLED=1 node scripts/studio.mjs",
    "studio:demo": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers ASTRO_TELEMETRY_DISABLED=1 node scripts/studio-demo.mjs",
    "studio:intake-demo": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers ASTRO_TELEMETRY_DISABLED=1 node scripts/studio-intake-demo.mjs",
    "studio:validation-demo": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers ASTRO_TELEMETRY_DISABLED=1 node scripts/studio-intake-demo.mjs --validation-flow",
    "studio:navigation-demo": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers ASTRO_TELEMETRY_DISABLED=1 node scripts/studio-intake-demo.mjs --navigation-flow",
    "studio:coordination-demo": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers ASTRO_TELEMETRY_DISABLED=1 node scripts/studio-multitab-demo.mjs",
    "studio:multitab-demo": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers ASTRO_TELEMETRY_DISABLED=1 node scripts/studio-multitab-demo.mjs",
    "verify": "npm run qualify:published-site",
    "state:check": "python3 .durable-state/framework/validator.py --strict . && node scripts/durable-state-check.mjs",
    "test:tier1": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers node --test tests/catalogue.test.mjs",
    "test:tier2:public": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers node --test tests/archive.test.mjs tests/catalogue.test.mjs tests/ingestion.test.mjs tests/moving-image.test.mjs tests/presentation.test.mjs tests/professional.test.mjs tests/publication.test.mjs tests/quality.test.mjs tests/smoke.test.mjs",
    "test:tier2:content-tools": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers node --test tests/ingestion.test.mjs tests/pilot.test.mjs",
    "test:tier2:studio": "PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers node --test tests/ingestion.test.mjs tests/pilot.test.mjs tests/studio.test.mjs",
    "qualify:published-site": "npm run state:check && npm run build && npm run release:check && npm run test:tier2:public",
    "qualify:private-studio": "npm run state:check && npm run build && npm run test:tier2:studio && PLAYWRIGHT_BROWSERS_PATH=/tmp/opencode/jordannesbitt-browsers node --test tests/publication.test.mjs tests/quality.test.mjs",
    "verify:all": "npm run state:check && npm run build && npm test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.13.5",
    "entities": "^8.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "axe-core": "4.13.0",
    "parse5": "8.0.1",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "typescript": "^5.9.2"
  }
}
