---
import "../styles/global.css";
import { identity } from "@/config/identity";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = identity.descriptor } = Astro.props;
const pageTitle = title ? `${title} — ${identity.name}` : identity.name;
const canonical = new URL(Astro.url.pathname, identity.siteUrl);
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
const artistSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: identity.name,
  url: identity.siteUrl,
  jobTitle: "Visual artist",
  address: {
    "@type": "PostalAddress",
    addressLocality: "London",
    addressRegion: "Ontario",
    addressCountry: "CA",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f0ede5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(artistSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label={`${identity.name}, home`}>
        {identity.name}
      </a>
      <nav aria-label="Primary navigation">
        <a href="/work" aria-current={isActive("/work") ? "page" : undefined}>Work</a>
        <a href="/archive" aria-current={isActive("/archive") ? "page" : undefined}>Archive</a>
        <a href="/about" aria-current={isActive("/about") ? "page" : undefined}>About</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{identity.name}</p>
      <p>{identity.location}</p>
      <p>© {new Date().getFullYear()}</p>
    </footer>
  </body>
</html>
