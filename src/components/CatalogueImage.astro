---
import type { Artwork } from "@/lib/catalogue";
import { imageSources } from "@/lib/presentation";
interface Props { image: Artwork["reproductions"][number]; sizes?: string; lead?: boolean; }
const { image, sizes = "(min-width: 1100px) 29vw, (min-width: 600px) 43vw, 88vw", lead = false } = Astro.props;
---
<picture class="catalogue-picture">
  {imageSources(image, "avif") && <source type="image/avif" srcset={imageSources(image, "avif")} sizes={sizes} />}
  {imageSources(image, "webp") && <source type="image/webp" srcset={imageSources(image, "webp")} sizes={sizes} />}
  <img src={image.src} srcset={imageSources(image, "jpeg") ?? imageSources(image, "png")} sizes={sizes} alt={image.alt}
    width={image.width} height={image.height} loading={lead ? "eager" : "lazy"} fetchpriority={lead ? "high" : undefined} decoding="async" />
</picture>
