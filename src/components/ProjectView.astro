---
import type { Artwork, Project } from "@/lib/catalogue";
import { dateLabel } from "@/lib/catalogue";
import ArtworkCard from "./ArtworkCard.astro";
interface Props { project: Project; members: Artwork[]; }
const { project, members } = Astro.props;
---
<header class="page-intro project-intro">
  <p class="eyebrow">Project / series</p><h1>{project.title}</h1>
  {project.date && <p>{dateLabel(project.date)}</p>}
  {project.description && <p>{project.description}</p>}
</header>
<ol class="ordered-sequence" aria-label="Authored project sequence">
  {members.map((work, index) => <li class:list={[index % 3 === 0 ? "sequence-feature" : "sequence-pair"]}><span class="sequence-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><ArtworkCard artwork={work} mode="project" scale={index % 3 === 0 ? "feature" : "standard"} /></li>)}
</ol>
<p class="page-return"><a class="text-link" href="/projects/">All projects</a></p>
