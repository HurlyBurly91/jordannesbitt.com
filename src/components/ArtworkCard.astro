---
import type { Artwork } from "@/data/artworks";

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
---

<article class="artwork-card">
  <a href={`/artwork/${artwork.slug}`}>
    {artwork.image ? (
      <img src={artwork.image} alt={artwork.alt} loading="lazy" width="1200" height="1500" />
    ) : (
      <div class="art-placeholder portrait" aria-label={artwork.alt}>
        <span class="placeholder-label">{artwork.title}</span>
      </div>
    )}
    <div class="artwork-meta">
      <h2>{artwork.title}</h2>
      <p>{artwork.year}</p>
    </div>
  </a>
</article>
