---
import type { Artwork } from "@/data/artworks";
import { dateLabel } from "@/lib/catalogue";

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
const image = artwork.reproductions.find((image) => image.role === "primary");
---

<article class="artwork-card">
  <a href={`/artwork/${artwork.slug}`}>
    {image ? (
      <img src={image.src} alt={image.alt} loading="lazy" width={image.width} height={image.height} />
    ) : (
      <div class="art-placeholder portrait">
        <span class="placeholder-label">{artwork.title}</span>
      </div>
    )}
    <div class="artwork-meta">
      <h2>{artwork.title}</h2>
      <p>{dateLabel(artwork.date)}</p>
    </div>
  </a>
</article>
