---
import type { Artwork } from "@/data/artworks";
import { dateLabel } from "@/lib/catalogue";
import { imageSources } from "@/lib/presentation";

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
const image = artwork.reproductions.find((image) => image.role === "primary");
---

<article class="artwork-card">
  <a href={`/artwork/${artwork.slug}/`}>
    {image ? (
      <picture>
        {imageSources(image, "avif") && <source type="image/avif" srcset={imageSources(image, "avif")} sizes="(max-width: 760px) 92vw, 45vw" />}
        {imageSources(image, "webp") && <source type="image/webp" srcset={imageSources(image, "webp")} sizes="(max-width: 760px) 92vw, 45vw" />}
        <img src={image.src} srcset={imageSources(image, "jpeg") ?? imageSources(image, "png")} sizes="(max-width: 760px) 92vw, 45vw" alt={image.alt} loading="lazy" width={image.width} height={image.height} />
      </picture>
    ) : (
      <div class="art-placeholder portrait">
        <span class="placeholder-label">{artwork.title}</span>
      </div>
    )}
    <div class="artwork-meta">
      <h2>{artwork.title}</h2>
      <p>{dateLabel(artwork.date)}</p>
    </div>
  </a>
</article>
