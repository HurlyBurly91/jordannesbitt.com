---
import type { Artwork } from "@/lib/catalogue";
import CatalogueImage from "./CatalogueImage.astro";
interface Props { image: Artwork["reproductions"][number]; lead?: boolean; sizes?: string; mode?: "object" | "additional" | "home"; }
const { image, lead = false, sizes = "(max-width: 760px) 88vw, 62vw", mode = "object" } = Astro.props;
const labels = { primary: "Full reproduction", alternate: "Alternate view", detail: "Detail", framed: "Framed view", installation: "Installation view", documentation: "Documentation", reverse: "Reverse", process: "Process view" };
---
<figure class:list={["reproduction", `reproduction--${mode}`]}>
  <a class="reproduction-open" href={image.src} data-inspect-image data-image-width={image.width} data-image-height={image.height} data-image-alt={image.alt}
    aria-label={`Inspect ${image.role} image: ${image.alt}`} aria-haspopup="dialog">
    <CatalogueImage image={image} lead={lead} sizes={sizes} />
  </a>
  <figcaption>
    <span>{labels[image.role]}{image.caption ? ` — ${image.caption}` : ""}</span>
    <span class="reproduction-actions"><a class="text-link" href={image.src} data-inspect-image data-image-width={image.width} data-image-height={image.height} data-image-alt={image.alt} aria-haspopup="dialog">Inspect {image.role} image</a><a class="image-file-link" href={image.src}>Open image file<span class="visually-hidden">: {image.alt}</span></a></span>
  </figcaption>
</figure>
