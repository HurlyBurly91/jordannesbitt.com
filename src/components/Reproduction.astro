---
import type { Artwork } from "@/lib/catalogue";
import { imageSources } from "@/lib/presentation";
interface Props { image: Artwork["reproductions"][number]; lead?: boolean; sizes?: string; }
const { image, lead = false, sizes = "(max-width: 760px) 92vw, 60vw" } = Astro.props;
const labels = { primary: "Full reproduction", detail: "Detail", installation: "Installation view", reverse: "Reverse", process: "Process view" };
---
<figure class="reproduction">
  <picture>
    {imageSources(image, "avif") && <source type="image/avif" srcset={imageSources(image, "avif")} sizes={sizes} />}
    {imageSources(image, "webp") && <source type="image/webp" srcset={imageSources(image, "webp")} sizes={sizes} />}
    <img src={image.src} srcset={imageSources(image, "jpeg") ?? imageSources(image, "png")} sizes={sizes} alt={image.alt}
      width={image.width} height={image.height} loading={lead ? "eager" : "lazy"} fetchpriority={lead ? "high" : undefined} decoding="async" />
  </picture>
  <figcaption>
    <span>{labels[image.role]}{image.caption ? ` — ${image.caption}` : ""}</span>
    <a class="text-link" href={image.src}>View full {image.role} image<span class="visually-hidden">: {image.alt}</span></a>
  </figcaption>
</figure>
