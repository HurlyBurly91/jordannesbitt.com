---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { identity } from "@/config/identity";
---

<BaseLayout title="About" description={`About ${identity.name}, a multidisciplinary artist based in ${identity.location}.`}>
  <header class="page-intro about-intro">
    <p class="eyebrow">About</p>
    <h1>{identity.name} is an artist based in {identity.location}.</h1>
  </header>
  <section class="about-grid">
    <p class="section-number">Practice</p>
    <div class="prose">
      <p>
        Nesbitt works across drawing, printmaking, painting, photography,
        aerial imaging, film, and computational systems.
      </p>
      <p>
        The practice joins direct observation and physical processes with
        constructed images, treating each medium as part of the same sustained
        investigation.
      </p>
    </div>
  </section>
</BaseLayout>
