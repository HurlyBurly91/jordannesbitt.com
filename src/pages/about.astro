---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { identity } from "@/config/identity";
import { professional } from "@/data/catalogue";
---
<BaseLayout title="About" description={`About ${identity.name}, artist based in ${identity.location}.`}>
  <header class="page-intro about-intro"><p class="eyebrow">About</p><h1>{identity.name}</h1><p>Artist based in {identity.location}.</p></header>
  {professional?.biography.length > 0 && <section class="professional-prose" aria-label="Approved biography">{professional.biography.map((paragraph) => <p>{paragraph}</p>)}</section>}
  {!professional?.biography.length && !professional?.statement.length && <p class="empty-state" data-release-blocker="missing-professional-content">Approved professional context has not been published.</p>}
  {professional?.statement.length > 0 && <section class="professional-prose"><h2>Practice statement</h2>{professional.statement.map((paragraph) => <p>{paragraph}</p>)}</section>}
  {(professional?.cv.length > 0 || professional?.cvPdf) && <p class="page-return"><a class="text-link" href="/cv/">View CV</a></p>}
</BaseLayout>
