---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { artworks } from "@/data/artworks";
import SelectedWork from "@/components/SelectedWork.astro";
import { populatedMedia } from "@/data/catalogue";

const published = artworks;
---

<BaseLayout title="Work" description="Selected work by Jordan Nesbitt, organized by medium.">
  <header class="page-intro">
    <p class="eyebrow">Selected work</p>
    <h1>Selected work.</h1>
  </header>
  <SelectedWork artworks={artworks} />
  {populatedMedia.length > 0 && <section class="medium-index" aria-label="Published media">
    <ol>
      {populatedMedia.map((item, index) => {
        const count = published.filter((artwork) => artwork.medium === item.slug).length;
        return (
          <li>
            <a href={`/work/${item.slug}`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{item.label}</strong>
              <span class="status">{count > 0 ? `${count} work${count === 1 ? "" : "s"}` : "Selection in preparation"}</span>
              <span class="arrow">↗</span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>}
</BaseLayout>
