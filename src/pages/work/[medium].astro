---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArtworkCard from "@/components/ArtworkCard.astro";
import { artworks } from "@/data/artworks";
import { mediumRoutes } from "@/data/catalogue";

export function getStaticPaths() {
  return mediumRoutes.map((item) => ({
    params: { medium: item.slug },
    props: {
      item,
      works: artworks
        .filter((artwork) => artwork.medium === item.slug)
        .sort((a, b) => (b.date.year ?? 0) - (a.date.year ?? 0)),
    },
  }));
}

const { item, works } = Astro.props;
---

<BaseLayout
  title={item.label}
  description={`${item.label} by Jordan Nesbitt, a visual artist in London, Ontario.`}
>
  <header class="page-intro medium-page">
    <p class="eyebrow">Medium</p>
    <h1>{item.label}</h1>
    <p>{works.length > 0 ? `${works.length} published work${works.length === 1 ? "" : "s"}.` : "No work is published in this medium yet."}</p>
  </header>
  {works.length > 0 ? (
    <section class="work-grid" aria-label={`${item.label} works`}>
      {works.map((work) => <ArtworkCard artwork={work} />)}
    </section>
  ) : (
    <p class="empty-state"><a class="text-link" href="/archive/">Browse the archive</a></p>
  )}
</BaseLayout>
