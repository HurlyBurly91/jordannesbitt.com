---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArtworkPlaceholder from "@/components/ArtworkPlaceholder.astro";
import { media } from "@/data/artworks";
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Visual artist · London, Ontario</p>
      <h1>A single practice across image, object, and moving picture.</h1>
      <p class="hero-intro">
        Drawing, printmaking, painting, photography, aerial imaging, film, and
        computational systems.
      </p>
      <a class="text-link" href="/work">View selected work <span>↗</span></a>
    </div>
    <div class="hero-art">
      <ArtworkPlaceholder label="Featured work" variant="portrait" index={1} />
    </div>
  </section>

  <section class="practice" aria-labelledby="practice-title">
    <p class="section-number">01 / Practice</p>
    <div>
      <h2 id="practice-title">
        The work moves between direct observation, physical process, and
        constructed images.
      </h2>
      <p>
        This site is being rebuilt as both a curated portfolio and a structured
        record of an expanding multidisciplinary practice.
      </p>
    </div>
  </section>

  <section class="medium-index" aria-labelledby="media-title">
    <div class="section-heading">
      <p class="section-number">02 / Media</p>
      <h2 id="media-title">Browse by medium</h2>
    </div>
    <ol>
      {media.map((item, index) => (
        <li>
          <a href={`/work/${item.slug}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{item.label}</strong>
            <span class="arrow">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="selected-grid" aria-labelledby="selected-title">
    <div class="section-heading">
      <p class="section-number">03 / Selected work</p>
      <h2 id="selected-title">A provisional exhibition wall</h2>
    </div>
    <div class="editorial-grid">
      <ArtworkPlaceholder label="Work 01" variant="landscape" index={1} />
      <ArtworkPlaceholder label="Work 02" variant="portrait" index={2} />
      <ArtworkPlaceholder label="Work 03" variant="square" index={3} />
    </div>
    <p class="work-note">
      Artwork slots are intentionally neutral. Images and metadata can be added
      without changing the layout.
    </p>
  </section>

  <section class="contact-panel">
    <p class="section-number">04 / Contact</p>
    <h2>Exhibitions, commissions, and print enquiries.</h2>
    <p>Contact details will be added before launch.</p>
  </section>
</BaseLayout>
