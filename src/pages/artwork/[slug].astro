---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { artworks } from "@/data/artworks";
import { dateLabel, dimensionLabel } from "@/lib/catalogue";

export function getStaticPaths() {
  return artworks
    .map((artwork) => ({
      params: { slug: artwork.slug },
      props: { artwork },
    }));
}

const { artwork } = Astro.props;
const image = artwork.reproductions.find((image) => image.role === "primary");
const details = [artwork.materials, ...artwork.dimensions.map(dimensionLabel)].filter(Boolean).join(" · ");
---

<BaseLayout title={artwork.title} description={`${artwork.title}, ${dateLabel(artwork.date)}, by Jordan Nesbitt.`}>
  <article class="artwork-detail">
    <div class="artwork-image">
      {image ? (
        <img src={image.src} alt={image.alt} width={image.width} height={image.height} />
      ) : (
        <div class="art-placeholder portrait">
          <span class="placeholder-label">{artwork.title}</span>
        </div>
      )}
    </div>
    <header>
      <p class="eyebrow">{artwork.medium}</p>
      <h1>{artwork.title}</h1>
      <p>{dateLabel(artwork.date)}</p>
      {details && <p class="artwork-details">{details}</p>}
      <a class="text-link" href={`/work/${artwork.medium}`}>Back to {artwork.medium}</a>
    </header>
  </article>
</BaseLayout>
